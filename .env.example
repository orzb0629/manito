# Client: public values only. Leave BOTH blank to keep the existing local demo.
VITE_SUPABASE_URL=
# Modern sb_publishable_... key is supported here, as is a legacy anon JWT.
VITE_SUPABASE_ANON_KEY=

# Server ONLY (Vercel Function / local API process). NEVER prefix these with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Modern sb_secret_... OR legacy service_role JWT. Never paste a real key in this file.
SUPABASE_SECRET_KEY=
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_PEPPER=
# Exact HTTPS origin, no path or trailing slash. No wildcard / preview URL auto-trust.
APP_ORIGIN=https://your-app.example.com

# Optional override for mkcert leaf files, server-side only.
# Empty = auto-discover .certs/localhost.pem and .certs/localhost-key.pem.
# dev:https never falls back to an untrusted self-signed certificate.
DEV_TLS_CERT_FILE=
DEV_TLS_KEY_FILE=
