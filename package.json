{
  "name": "manito",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test": "node --experimental-strip-types --test src/game.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:security": "node --experimental-strip-types --test tests/security.test.ts tests/database.test.ts tests/management.test.ts tests/local-setup.test.ts tests/dev-tls.test.ts tests/short-codes.test.ts tests/assignment-flow.test.ts tests/activity-reset.test.ts",
    "test:all": "npm run test && npm run test:security",
    "dev:https": "vite --host 0.0.0.0 --mode https",
    "setup:local": "node scripts/setup-local.mjs",
    "test:browser": "node --experimental-strip-types --test tests/browser.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
